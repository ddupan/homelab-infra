{
  "name": "oci-hosted",
  "online": true,
  "storage": {
    "blobStoreName": "default",
    "strictContentTypeValidation": true,
    "writePolicy": "ALLOW",
    "latestPolicy": false
  },
  "oci": {
    "v1Enabled": false,
    "forceBasicAuth": false,
    "pathEnabled": true
  },
  "component": { "proprietaryComponents": false },
  "cosign": { "enforcement": "NONE" }
}

[% for record in records %]
  [[ record.name | replace('.', '-') ]].server: |
    [[ record.name ]]:53 {
        errors
        template IN A {
            answer "{{ .Name }} 60 IN A [[ record['values'][0] ]]"
        }
        template IN AAAA {
            rcode NOERROR
        }
    }
[% endfor %]

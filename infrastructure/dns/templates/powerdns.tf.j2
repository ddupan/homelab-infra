# Generated by infrastructure/dns/generate.py from records.yml (homelab_dns.powerdns).
# Do not edit directly.
[% for record in records %]

resource "powerdns_record" "[[ record.name | replace('-', '_') ]]_[[ record.type | lower ]]" {
  zone    = powerdns_zone.lab.name
  name    = "[[ record.name ]].lab.ddupan.top."
  type    = "[[ record.type ]]"
  ttl     = [[ record.ttl | default(300) ]]
  records = [[ record['values'] | tojson ]]
}
[% endfor %]

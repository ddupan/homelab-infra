# Ansible managed
name: {{ inventory_hostname }}
namespace: /homelab/patroni/
scope: pg-sandbox
restapi:
  listen: {{ ansible_host }}:8008
  connect_address: {{ ansible_host }}:8008
  # VyOS polls GET /primary; changes (switchover, restart) only from the members.
  allowlist: [127.0.0.1]
  allowlist_include_members: true
etcd3:
  hosts: {{ sandbox_patroni_etcd_hosts | to_json }}
  protocol: https
  username: {{ sandbox_patroni_etcd_secret.json.data.data.username | to_json }}
  password: {{ sandbox_patroni_etcd_secret.json.data.data.password | to_json }}
  cacert: /etc/patroni/ca.crt
  cert: /etc/patroni/etcd.crt
  key: /etc/patroni/etcd.key
bootstrap:
  # Applied once, when the cluster is first written to etcd; later changes go
  # through `patronictl edit-config`.
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    # Sync while sandbox2 is healthy, async while it is gone: losing a node
    # must not stop K3s writes.
    synchronous_mode: true
    synchronous_mode_strict: false
    # Keep the primary writable when etcd itself is unreachable but both
    # members can still see each other.
    failsafe_mode: true
    postgresql:
      use_pg_rewind: false
      use_slots: true
      parameters:
        wal_level: replica
        hot_standby: 'on'
        max_wal_senders: 10
        max_replication_slots: 10
        # A dead member's slot must not fill the rootfs.
        max_slot_wal_keep_size: 2GB
  initdb:
    - encoding: UTF8
    - data-checksums
postgresql:
  listen: {{ ansible_host }},127.0.0.1:5432
  connect_address: {{ ansible_host }}:5432
  data_dir: {{ sandbox_postgresql_data_dir }}
  bin_dir: /usr/lib/postgresql/{{ sandbox_postgresql_version }}/bin
  pgpass: /var/lib/postgresql/.pgpass-patroni
  use_unix_socket: true
  authentication:
    superuser:
      username: postgres
    replication:
      username: {{ sandbox_postgresql_replication_user | to_json }}
      password: {{ sandbox_postgresql_replication_password | to_json }}
  parameters:
    unix_socket_directories: /var/run/postgresql
    password_encryption: scram-sha-256
  pg_hba:
    - local all postgres peer
    - local all all peer
    - host {{ sandbox_postgresql_database }} {{ sandbox_postgresql_user }} 10.60.0.0/24 scram-sha-256
    - host replication {{ sandbox_postgresql_replication_user }} 10.60.0.0/24 scram-sha-256
  # No pg_rewind (it needs a networked superuser): a diverged old primary is
  # recloned from the leader. The datastore is small and disposable.
  remove_data_directory_on_diverged_timelines: true
  callbacks:
    on_role_change: /etc/patroni/on-role-change.sh
watchdog:
  mode: 'off'

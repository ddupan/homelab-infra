#cloud-config
# NoCloud user-data for the OpenBao host VM.
hostname: {{ bao_vm_name }}
fqdn: {{ bao_vm_name }}.{{ bao_vm_domain }}
preserve_hostname: false

users:
  - name: {{ bao_vm_user }}
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - {{ bao_vm_ssh_pubkey }}

ssh_pwauth: false
package_update: true
package_upgrade: false

{# Desired VyOS config as `set` lines. vyos_config diffs these against the
   running config, so only differences are applied. Written for VyOS 2025.11
   syntax explicitly -- see defaults/main.yml for why we do not use the
   collection's resource modules. #}
set system host-name {{ vyos_router_hostname }}
set system name-server {{ vyos_nameserver }}

{# --- LAN leg: BGP peer with the NEC IX --- #}
set interfaces ethernet {{ vyos_lan_interface }} address {{ vyos_lan_address }}
set interfaces ethernet {{ vyos_lan_interface }} description 'LAN / BGP to NEC IX'

{# --- SDN legs: gateways for the PVE VNets --- #}
{% for i in vyos_sdn_interfaces %}
set interfaces ethernet {{ i.iface }} address {{ i.address }}
set interfaces ethernet {{ i.iface }} description '{{ i.description }}'
{% endfor %}

{# --- default route out; BGP to the IX carries the rest --- #}
set protocols static route 0.0.0.0/0 next-hop {{ vyos_lan_gateway }}

{# --- BGP to the NEC IX: summaries out, nothing in --- #}
{% for a in vyos_ix_aggregates %}
set protocols bgp address-family ipv4-unicast aggregate-address {{ a }}
{# The aggregate alone installs a blackhole: a withdrawn VIP would make clients wait
   for a timeout. The reject route (distance 1, beats the aggregate's 200) answers ICMP
   unreachable instead; connected subnets and VIP /32s are more specific and still win. #}
set protocols static route {{ a }} reject
{% endfor %}
{% for p in vyos_ix_export %}
set policy prefix-list IX-OUT rule {{ loop.index * 10 }} action 'permit'
set policy prefix-list IX-OUT rule {{ loop.index * 10 }} prefix '{{ p }}'
{% endfor %}
set policy prefix-list IX-IN rule 10 action 'deny'
set policy prefix-list IX-IN rule 10 prefix '0.0.0.0/0'
set policy prefix-list IX-IN rule 10 le '32'
set protocols bgp neighbor {{ vyos_ix_neighbor }} description 'NEC IX'
set protocols bgp neighbor {{ vyos_ix_neighbor }} remote-as '{{ vyos_ix_remote_as }}'
set protocols bgp neighbor {{ vyos_ix_neighbor }} local-as {{ vyos_bgp_internal_local_as }} no-prepend replace-as
set protocols bgp neighbor {{ vyos_ix_neighbor }} timers keepalive '10'
set protocols bgp neighbor {{ vyos_ix_neighbor }} timers holdtime '30'
set protocols bgp neighbor {{ vyos_ix_neighbor }} address-family ipv4-unicast prefix-list import 'IX-IN'
set protocols bgp neighbor {{ vyos_ix_neighbor }} address-family ipv4-unicast prefix-list export 'IX-OUT'

{# --- BGP to the LoadBalancer hosts: VIP /32s in, nothing out --- #}
{# ECMP across the LB hosts of one environment: every host announces the same VIP, and
   without this only one path is installed. Hosts of an environment share one AS, so no
   as-path multipath-relax is needed. #}
set protocols bgp address-family ipv4-unicast maximum-paths ebgp {{ vyos_lb_maximum_paths }}
set policy prefix-list LB-OUT rule 10 action 'deny'
set policy prefix-list LB-OUT rule 10 prefix '0.0.0.0/0'
set policy prefix-list LB-OUT rule 10 le '32'
{% for g in vyos_lb_peer_groups %}
set policy prefix-list {{ g.name }}-IN rule 10 action 'permit'
set policy prefix-list {{ g.name }}-IN rule 10 prefix '{{ g.vip_pool }}'
set policy prefix-list {{ g.name }}-IN rule 10 ge '32'
set policy prefix-list {{ g.name }}-IN rule 10 le '32'
set protocols bgp peer-group {{ g.name }} remote-as '{{ g.remote_as }}'
set protocols bgp peer-group {{ g.name }} local-as {{ vyos_bgp_internal_local_as }} no-prepend replace-as
set protocols bgp peer-group {{ g.name }} passive
set protocols bgp peer-group {{ g.name }} address-family ipv4-unicast prefix-list import '{{ g.name }}-IN'
set protocols bgp peer-group {{ g.name }} address-family ipv4-unicast prefix-list export 'LB-OUT'
{% for n in g.neighbors %}
set protocols bgp neighbor {{ n }} peer-group '{{ g.name }}'
{% endfor %}
{% endfor %}

{# --- K3s PostgreSQL datastore: fixed endpoint following the Patroni leader --- #}
set load-balancing haproxy service sandbox-postgresql listen-address {{ vyos_postgresql_listen_address }}
set load-balancing haproxy service sandbox-postgresql port {{ vyos_postgresql_port }}
set load-balancing haproxy service sandbox-postgresql mode 'tcp'
set load-balancing haproxy service sandbox-postgresql backend 'sandbox-postgresql-primary'
set load-balancing haproxy backend sandbox-postgresql-primary mode 'tcp'
set load-balancing haproxy backend sandbox-postgresql-primary http-check method 'get'
set load-balancing haproxy backend sandbox-postgresql-primary http-check uri '/primary'
set load-balancing haproxy backend sandbox-postgresql-primary http-check expect 'status 200'
{% for server in vyos_postgresql_servers %}
set load-balancing haproxy backend sandbox-postgresql-primary server {{ server.name }} address {{ server.address }}
set load-balancing haproxy backend sandbox-postgresql-primary server {{ server.name }} port {{ vyos_postgresql_port }}
set load-balancing haproxy backend sandbox-postgresql-primary server {{ server.name }} check port {{ vyos_patroni_api_port }}
{% endfor %}

{# --- management --- #}
set service ssh port 22
{# --- monitoring: built-in exporters. node-exporter's textfile collector carries the
     unit states written by vyos-unit-metrics (vyos-monitoring.yml); VyOS's node_exporter
     runs only the default collectors, which have no systemd. --- #}
set service monitoring prometheus node-exporter listen-address {{ vyos_monitoring_listen_address }}
set service monitoring prometheus node-exporter port {{ vyos_node_exporter_port }}
set service monitoring prometheus node-exporter collectors textfile
set service monitoring prometheus frr-exporter listen-address {{ vyos_monitoring_listen_address }}
set service monitoring prometheus frr-exporter port {{ vyos_frr_exporter_port }}

{# --- DHCP for the SDN VNets --- #}
{% for i in vyos_sdn_interfaces if i.dhcp is defined %}
set service dhcp-server shared-network-name {{ i.vnet | upper }} subnet {{ i.network }} subnet-id {{ i.dhcp.subnet_id }}
set service dhcp-server shared-network-name {{ i.vnet | upper }} subnet {{ i.network }} option default-router {{ i.address.split('/')[0] }}
set service dhcp-server shared-network-name {{ i.vnet | upper }} subnet {{ i.network }} option name-server {{ vyos_dhcp_nameserver }}
set service dhcp-server shared-network-name {{ i.vnet | upper }} subnet {{ i.network }} option domain-name {{ i.dhcp.domain }}
{% if i.dhcp.wins is defined %}
set service dhcp-server shared-network-name {{ i.vnet | upper }} subnet {{ i.network }} option wins-server {{ i.dhcp.wins }}
{% endif %}
set service dhcp-server shared-network-name {{ i.vnet | upper }} subnet {{ i.network }} range 0 start {{ i.dhcp.start }}
set service dhcp-server shared-network-name {{ i.vnet | upper }} subnet {{ i.network }} range 0 stop {{ i.dhcp.stop }}
{% for r in i.dhcp.reservations | default([]) %}
set service dhcp-server shared-network-name {{ i.vnet | upper }} subnet {{ i.network }} static-mapping {{ r.name }} mac {{ r.mac }}
set service dhcp-server shared-network-name {{ i.vnet | upper }} subnet {{ i.network }} static-mapping {{ r.name }} ip-address {{ r.address }}
{% endfor %}
{% endfor %}

{
  "uid": "overview",
  "title": "Homelab 总览",
  "id": null,
  "editable": true,
  "schemaVersion": 39,
  "description": "COVERAGE Z2：每台主机 / 每个入口一个红绿格。手写看板，不经 import.py。",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "1m",
  "tags": [
    "overview"
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "主机",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (node) (label_replace(up{job=\"node-exporter\"}, \"node\", \"$1\", \"host\", \"(.+)\"))",
          "legendFormat": "{{node}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "text": {
          "titleSize": 14,
          "valueSize": 14
        },
        "minVizWidth": 140,
        "minVizHeight": 50
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "故障",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "正常",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "无数据",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "入口",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (probe_group, target) (label_replace(probe_success, \"target\", \"$1$2\", \"instance\", \"(?:https?://)?([^/?]+)(/[^?]*)?.*\"))",
          "legendFormat": "{{probe_group}} · {{target}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "text": {
          "titleSize": 14,
          "valueSize": 14
        },
        "minVizWidth": 140,
        "minVizHeight": 50
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "故障",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "正常",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "无数据",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    }
  ]
}
